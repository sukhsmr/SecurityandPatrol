<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS / Plesk (Windows) configuration for the Node.js server build.

  IIS starts `node server.js` through the ASP.NET Core Module (ANCM), which is
  installed with IIS on Plesk Windows servers, and forwards every request to
  it. (iisnode, which Plesk's Node.js page configures by default, fails to
  load on this server: HTTP 500.21.) See docs/DEPLOYMENT.md.
-->
<configuration>
  <system.webServer>
    <handlers>
      <remove name="iisnode" />
      <remove name="aspNetCore" />
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>

    <aspNetCore
      processPath="C:\Program Files\nodejs\node.exe"
      arguments=".\server.js"
      hostingModel="OutOfProcess"
      startupTimeLimit="120"
      requestTimeout="00:05:00"
      stdoutLogEnabled="true"
      stdoutLogFile=".\logs\node">
      <environmentVariables>
        <environmentVariable name="NODE_ENV" value="production" />
        <!-- The app pool can only write inside App_Data (which IIS never serves),
             so content, uploads and logs live there. server.js copies data\
             into App_Data\cms\data on first start. -->
        <environmentVariable name="CMS_DATA_DIR" value="App_Data\cms\data" />
        <environmentVariable name="CMS_UPLOAD_DIR" value="App_Data\cms\uploads" />
        <environmentVariable name="CMS_LOG_DIR" value="App_Data\cms\logs" />
      </environmentVariables>
    </aspNetCore>

    <security>
      <requestFiltering>
        <!-- Defence in depth: these folders/files must never be served directly.
             Each is removed first because the server may already hide some of
             them; adding an existing entry is a duplicate-entry error (500.19). -->
        <hiddenSegments>
          <remove segment="node_modules" />
          <add segment="node_modules" />
          <remove segment=".next" />
          <add segment=".next" />
          <remove segment="data" />
          <add segment="data" />
          <remove segment="src" />
          <add segment="src" />
          <remove segment="scripts" />
          <add segment="scripts" />
          <remove segment="logs" />
          <add segment="logs" />
          <remove segment=".env.local" />
          <add segment=".env.local" />
          <remove segment=".env" />
          <add segment=".env" />
        </hiddenSegments>
        <!-- Allow image uploads up to the CMS limit (5 MB) plus overhead. -->
        <requestLimits maxAllowedContentLength="10485760" />
      </requestFiltering>
    </security>

    <!-- The Node app serves "/" itself. Plesk adds its startup file to the IIS
         default-document list, which would rewrite "/" to "/.plesk.startup.cjs". -->
    <defaultDocument enabled="false" />

    <!-- Show the site's own 404/500 pages instead of the IIS error page. -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
