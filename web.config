<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS / Plesk (Windows) configuration for the Node.js server build.
  Every request is handed to server.js through iisnode; Next.js serves pages,
  /admin, /api, /_next assets and files in public/. See docs/DEPLOYMENT.md.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!-- Never expose iisnode's own debug/log endpoints. -->
        <rule name="BlockIisnodeInternals" stopProcessing="true">
          <match url="^(server\.js/debug|iisnode)" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>
        <!-- Everything else goes to the Next.js app (pages, admin, API, assets). -->
        <rule name="NextApp" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    <security>
      <requestFiltering>
        <!-- Defence in depth: these folders/files must never be served directly. -->
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment=".next" />
          <add segment="data" />
          <add segment="src" />
          <add segment="scripts" />
          <add segment=".env.local" />
          <add segment=".env" />
          <add segment="iisnode" />
        </hiddenSegments>
        <!-- Allow image uploads up to the CMS limit (5 MB) plus overhead. -->
        <requestLimits maxAllowedContentLength="10485760" />
      </requestFiltering>
    </security>

    <!-- Show the site's own 404/500 pages instead of the IIS error page. -->
    <httpErrors existingResponse="PassThrough" />

    <iisnode
      node_env="production"
      nodeProcessCountPerApplication="1"
      loggingEnabled="true"
      logDirectory="iisnode"
      devErrorsEnabled="false"
      watchedFiles="web.config;server.js;.env.local"
      flushResponse="true"
      enableXFF="true"
      promoteServerVars="HTTPS" />
  </system.webServer>
</configuration>
