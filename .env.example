# Admin panel credentials. Generate the hash and secret with:
#   npm run cms:hash-password -- "your-strong-password"
CMS_ADMIN_USERNAME=admin
CMS_ADMIN_PASSWORD_HASH=
# Random string, at least 32 characters. Changing it signs everyone out.
CMS_SESSION_SECRET=

# Optional: store content somewhere other than ./data
# CMS_DATA_DIR=/var/lib/site-content
