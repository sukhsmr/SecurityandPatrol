# Admin panel credentials. Generate the hash and secret with:
#   npm run cms:hash-password -- "your-strong-password"
CMS_ADMIN_USERNAME=admin
CMS_ADMIN_PASSWORD_HASH=
# Random string, at least 32 characters. Changing it signs everyone out.
CMS_SESSION_SECRET=

# Optional: store content somewhere other than ./data
# CMS_DATA_DIR=/var/lib/site-content

# Email / SMTP configuration for Contact & Quote form submissions
# (If omitted, emails are safely logged to console and stored in submissions table)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@securityandpatrol.com
SMTP_PASS=your-smtp-password
SMTP_FROM="Rayven Security Protection" <info@securityandpatrol.com>
NOTIFICATION_EMAIL=info@securityandpatrol.com

